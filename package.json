{
  "name": "intelligent-bistro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/backend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "dev:web": "npm --workspace apps/mobile run web",
    "eval:ai": "npm --workspace apps/backend run eval:ai",
    "typecheck": "npm --workspace apps/backend run typecheck && npm --workspace apps/mobile run typecheck"
  }
}
